{
  "expo": {
    "name": "ConsentIA",
    "slug": "consentia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "consentia",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.consentia.app"
    },
    "android": {
      "package": "com.consentia.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A2138",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "ConsentIA utilise l'appareil photo pour scanner vos documents. Aucune photo n'est conservée après l'analyse."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0A2138",
          "imageWidth": 200
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "18a2b811-1968-4ce6-89a5-a1adcf6451e5"
      }
    }
  }
}
